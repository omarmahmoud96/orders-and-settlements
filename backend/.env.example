# Copy to .env and adjust.

# Required. Postgres is the only supported database.
DATABASE_URL=postgres://settlements:settlements@localhost:5432/settlements

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC

# Origins allowed to call the API directly from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.example.com
# DJANGO_LOG_LEVEL=INFO
